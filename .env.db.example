# ОБЩИЕ КРЕДЫ ДЛЯ БД.
# В продакшине обязательно замените логин/пароль на свои значения.
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=admin
DATABASE_PASSWORD=change-me-strong-db-password
DATABASE_NAME=mtr_project

# Для контейнера Postgres (эквивалентно DATABASE_*)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=mtr_project
