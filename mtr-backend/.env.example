NODE_ENV=production
PORT=3001

# HTTPS сертификаты backend внутри контейнера.
HTTPS_CERTS_DIR=certs
HTTPS_CERT_PATH=/app/certs/localhost.pem
HTTPS_KEY_PATH=/app/certs/localhost-key.pem

# CORS. Для docker-compose через nginx обычно достаточно адреса frontend.
# Можно указать несколько адресов через запятую.
CORS_ORIGIN=https://localhost:8443

# JWT. В продакшине обязательно заменить на длинные случайные строки.
JWT_SECRET=change-me-generate-long-random-string
JWT_REFRESH_SECRET=change-me-generate-another-long-random-string
JWT_TTL=900s
JWT_REFRESH_TTL=30d

# AD DS / LDAP authentication. Existing local JWT login remains available.
AD_ENABLED=false
AD_URL=ldap://192.168.2.20:389
AD_DOMAIN=mfc.dom
AD_BASE_DN=DC=mfc,DC=dom
# Optional. Examples:
# In docker compose env files escape $ as $$.
# AD_USER_DN_TEMPLATE=$${username}@$${domain}
# AD_USER_DN_TEMPLATE=$${domain}\$${username}
AD_USER_DN_TEMPLATE=$${username}@$${domain}
AD_TIMEOUT_MS=5000
